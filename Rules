#!/usr/bin/env ruby

compile '/index.erb.html' do
  filter :erb
  layout '/home.*'

  write '/index.html'
end

compile '/**/*.scss' do
  filter :sass, syntax: :scss
  write @item.identifier.without_ext + '.css'
end

# Everything else (CNAME, about.html, scripts, images) is copied as is.
# CNAME must reach the root of the output: GitHub Pages reads the custom
# domain, melnykov.dev, from it.
compile '/**/*' do
  write item.identifier.to_s
end

layout '/**/*', :erb
